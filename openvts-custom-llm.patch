+param(
+    [ValidateRange(1, 30)][int]$TimeoutMinutes = 30,
+    [switch]$Installer
+)
+$ErrorActionPreference = 'Stop'
+$root = Split-Path $PSScriptRoot -Parent
+$logs = Join-Path $root 'build-logs'
+New-Item -ItemType Directory -Force -Path $logs | Out-Null
+$worker = Join-Path $PSScriptRoot 'build-worker.ps1'
+Write-Host "Building Open VTS Terminal. Hard timeout: $TimeoutMinutes minutes for the entire build."
+Write-Host "Logs: $logs"
+$workerArguments = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ('"' + $worker + '"'))
+if ($Installer) { $workerArguments += '-Installer' }
+$process = Start-Process powershell.exe -ArgumentList $workerArguments -WorkingDirectory $root -PassThru -NoNewWindow -RedirectStandardOutput (Join-Path $logs 'stdout.log') -RedirectStandardError (Join-Path $logs 'stderr.log')
+if (-not $process.WaitForExit($TimeoutMinutes * 60000)) {
+    & taskkill.exe /PID $process.Id /T /F | Out-Null
+    throw "Build stopped after $TimeoutMinutes minutes. Check dist for any earlier completed files; this run did not complete. Cached compilation can be reused on a later run."
+}
+$process.WaitForExit()
+Get-Content (Join-Path $logs 'stdout.log') -Tail 80 -ErrorAction SilentlyContinue
+Get-Content (Join-Path $logs 'stderr.log') -Tail 100 -ErrorAction SilentlyContinue
+if ($process.ExitCode -ne 0) { throw "Build failed with exit code $($process.ExitCode). See build-logs." }
