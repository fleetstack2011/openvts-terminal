+$env:CARGO_FULL_PROFILE = 'release'
+$env:CARGO_BIN_NAME = 'oss'
+$env:WARP_APP_NAME = 'Open VTS Terminal'
+$env:GIT_RELEASE_TAG = 'v0.1.0-openvts'
+if (-not $env:LIBCLANG_PATH -and (Test-Path 'C:\Program Files\LLVM\bin')) { $env:LIBCLANG_PATH = 'C:\Program Files\LLVM\bin' }
+Run 'rustup' @('target', 'add', 'x86_64-pc-windows-msvc')
+Run 'cargo' @('test', '--manifest-path', 'openvts/adapter/Cargo.toml', '--jobs', '2')
+Run 'cargo' @('clippy', '--manifest-path', 'openvts/adapter/Cargo.toml', '--all-targets', '--', '-D', 'warnings')
+Run 'cargo' @('build', '--release', '-p', 'warp', '--bin', 'openvts', '--features', 'openvts,gui,release_bundle', '--target', 'x86_64-pc-windows-msvc', '--jobs', '2')
+Run 'cargo' @('fmt', '--package', 'warp')
+Run 'cargo' @('fmt', '--manifest-path', 'openvts/adapter/Cargo.toml')
+@("Build UTC: $([DateTime]::UtcNow.ToString('o'))", 'Adapter tests: passed', 'Adapter Clippy: passed', 'Windows x64 release compilation: passed', 'Rust formatting: completed', 'Interactive Windows GUI and authenticated LLM request: not verified by this build') | Set-Content 'openvts/VALIDATION.txt'
+if (-not (Get-Command 'cargo-about' -ErrorAction SilentlyContinue)) { Run 'cargo' @('install', '--locked', 'cargo-about', '--version', '0.8.4') }
+$binary = Join-Path (Get-Location) 'target\x86_64-pc-windows-msvc\release\openvts.exe'
+if (-not (Test-Path $binary)) { throw 'No executable was produced.' }
+$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
+$dist = Join-Path (Get-Location) 'dist'
+$stage = Join-Path $dist "OpenVTSTerminal-$stamp"
+New-Item -ItemType Directory -Force -Path $stage | Out-Null
+Copy-Item $binary (Join-Path $stage 'OpenVTSTerminal.exe')
+foreach ($name in @('conpty.dll', 'dxcompiler.dll', 'dxil.dll', 'vcruntime140.dll', 'vcruntime140_1.dll', 'msvcp140.dll')) {
+    Copy-Item "app\assets\windows\x64\$name" $stage
+}
+New-Item -ItemType Directory -Force -Path (Join-Path $stage 'x64') | Out-Null
+Copy-Item 'app\assets\windows\x64\OpenConsole.exe' (Join-Path $stage 'x64')
+Copy-Item 'app\assets\bundled\bootstrap\pwsh.ps1' $stage
+$env:SETTINGS_SCHEMA_EXECUTABLE = Join-Path $stage 'OpenVTSTerminal.exe'
+Remove-Item Env:SETTINGS_SCHEMA_SOURCE -ErrorAction SilentlyContinue
+Remove-Item Env:SKIP_SETTINGS_SCHEMA -ErrorAction SilentlyContinue
+& 'script\windows\prepare_bundled_resources.ps1' -DestinationDir (Join-Path $stage 'resources') -Channel 'oss'
+if (-not $?) { throw 'Resource packaging failed.' }
+Copy-Item 'openvts\openvts-llm.json', 'openvts\Start-OpenVTS.cmd', 'openvts\Start-OpenVTS.ps1', 'openvts\VALIDATION.txt', 'OPENVTS-README.md', 'LICENSE-AGPL', 'LICENSE-MIT' $stage
+Get-ChildItem $stage -Recurse -File | Get-FileHash -Algorithm SHA256 | ForEach-Object { "$($_.Hash)  $($_.Path.Substring($stage.Length + 1))" } | Set-Content (Join-Path $stage 'SHA256SUMS.txt')
+Compress-Archive -Path $stage -DestinationPath "$stage.zip"
+Write-Host "Created $stage.zip"
+
+if ($Installer) {
+    Run $iscc @("/DSourceDir=$stage", "/DOutputDir=$dist", 'openvts/installer.iss')
+    $setup = Join-Path $dist 'OpenVTSTerminalSetup.exe'
+    if (-not (Test-Path $setup)) { throw 'Installer compiler produced no setup executable.' }
+    Get-FileHash $setup -Algorithm SHA256 | ForEach-Object { "$($_.Hash)  OpenVTSTerminalSetup.exe" } | Set-Content (Join-Path $dist 'OpenVTSTerminalSetup.exe.sha256')
+    Write-Host "Created $setup"
+}
