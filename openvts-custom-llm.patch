+use super::*;
+
+fn request() -> api::Request {
+    from_json(json!({"input":{"userInputs":{"inputs":[{"userQuery":{"query":"Hello"}}]}}})).unwrap()
+}
+
+#[test]
+fn request_uses_the_configured_model_and_qwen_options() {
+    let prepared = prepare(&request(), &Config::default(), "request-1").unwrap();
+    assert_eq!(prepared.body["model"], "Qwen3.6-35B-A3B-GPTQ-Int4");
+    assert_eq!(prepared.body["chat_template_kwargs"]["enable_thinking"], true);
+    assert_eq!(prepared.body["temperature"], 0.1);
+    assert_eq!(prepared.body["max_tokens"], 131000);
+    assert_eq!(prepared.body["stream"], false);
+    assert_eq!(prepared.body["messages"][1]["content"], "Hello");
+    assert!(prepared.body.get("tools").is_none());
+}
+
+#[test]
+fn credentials_cannot_be_embedded_in_the_url_or_config() {
+    let config = Config { endpoint: "https://user:secret@example.com/v1/chat/completions".into(), ..Config::default() };
+    assert!(config.validate().is_err());
+    assert!(serde_json::from_value::<Config>(json!({"api_key":"secret"})).is_err());
+    assert!(validate_token("bearer_token_place_here").is_err());
+}
+
+#[test]
+fn rejects_truncated_tool_calls() {
+    let mut prepared = prepare(&request(), &Config::default(), "r").unwrap();
+    prepared.shell_enabled = true;
+    let response = json!({"choices":[{"finish_reason":"length","message":{"tool_calls":[{
+        "id":"call-1","type":"function","function":{"name":"run_shell_command","arguments":"{\"command\":\"dir\"}"}
+    }]}}]});
+    assert!(decode_response(response, &prepared, "r").is_err());
+}
+
+#[test]
+fn shell_commands_cannot_claim_to_be_safe() {
+    let mut prepared = prepare(&request(), &Config::default(), "r").unwrap();
+    prepared.shell_enabled = true;
+    let response = json!({"choices":[{"finish_reason":"tool_calls","message":{"tool_calls":[{
+        "id":"call-1","type":"function","function":{"name":"run_shell_command","arguments":"{\"command\":\"dir\"}"}
+    }]}}]});
+    let (messages, has_tools, _) = decode_response(response, &prepared, "r").unwrap();
+    let value = to_json(&messages[0]).unwrap();
+    assert!(has_tools);
+    assert_eq!(value["toolCall"]["runShellCommand"]["isRisky"], true);
+    assert_ne!(value["toolCall"]["runShellCommand"]["isReadOnly"], true);
+}
+
+#[test]
+fn missing_tool_results_are_not_reported_as_success() {
+    let mut messages = Vec::new();
+    let mut pending = HashSet::from(["call-1".into()]);
+    finish_missing_calls(&mut messages, &mut pending);
+    assert_eq!(messages[0]["tool_call_id"], "call-1");
+    assert_eq!(messages[0]["content"], "No result is available. The operation may have been cancelled. Do not assume it succeeded.");
+}
+
+#[test]
+fn response_events_match_the_native_protocol() {
+    assert!(action(json!({"beginTransaction":{}})).is_ok());
+    assert!(action(json!({"commitTransaction":{}})).is_ok());
+    assert!(from_json::<api::ResponseEvent>(json!({"finished":{"done":{}}})).is_ok());
+}
+
+#[tokio::test]
+async fn http_tool_response_completes_successfully_and_preserves_the_wire_request() {
+    use std::io::{BufRead, BufReader, Read, Write};
+    use std::net::TcpListener;
+
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let endpoint = format!("http://{}/v1/chat/completions", listener.local_addr().unwrap());
+    let server = std::thread::spawn(move || {
+        let deadline = std::time::Instant::now() + Duration::from_secs(10);
+        let mut socket = loop {
+            match listener.accept() {
+                Ok((socket, _)) => break socket,
+                Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                    assert!(std::time::Instant::now() < deadline, "No test request received");
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+                Err(error) => panic!("Test listener failed: {error}"),
+            }
+        };
+        socket.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+        socket.set_write_timeout(Some(Duration::from_secs(5))).unwrap();
+        let mut reader = BufReader::new(socket.try_clone().unwrap());
+        let mut headers = String::new();
+        loop {
+            let mut line = String::new();
+            assert!(reader.read_line(&mut line).unwrap() > 0);
+            if line == "\r\n" { break; }
+            headers.push_str(&line);
+        }
+        assert!(headers.starts_with("POST /v1/chat/completions HTTP/1.1\r\n"));
+        assert!(headers.to_ascii_lowercase().contains("authorization: bearer local-test-token\r\n"));
+        let length: usize = headers.lines().find_map(|line| {
+            let (name, value) = line.split_once(':')?;
+            name.eq_ignore_ascii_case("content-length").then(|| value.trim().parse().unwrap())
+        }).unwrap();
+        let mut body = vec![0; length];
+        reader.read_exact(&mut body).unwrap();
+        let request: Value = serde_json::from_slice(&body).unwrap();
+        assert_eq!(request["model"], DEFAULT_MODEL);
+        assert_eq!(request["messages"][1]["content"], "Hello");
+        assert_eq!(request["chat_template_kwargs"]["enable_thinking"], true);
+        assert_eq!(request["max_tokens"], 131000);
+        assert_eq!(request["temperature"], 0.1);
+        assert_eq!(request["tools"][0]["function"]["name"], "run_shell_command");
+        let response = json!({"choices":[{"finish_reason":"tool_calls","message":{
+            "content":null,"tool_calls":[{"id":"call-1","type":"function","function":{
+                "name":"run_shell_command","arguments":"{\"command\":\"Get-Location\"}"
+            }}]
+        }}]}).to_string();
+        write!(socket, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", response.len(), response).unwrap();
+    });
+    let mut native_request = request();
+    native_request.settings = Some(api::request::Settings {
+        supported_tools: vec![api::ToolType::RunShellCommand as i32],
+        ..Default::default()
+    });
+    let result = generate(native_request, Config { endpoint, timeout_seconds: 5, ..Config::default() }, "local-test-token".into()).await;
+    server.join().unwrap();
+    let events = result.unwrap();
+    let finish = to_json(events.last().unwrap()).unwrap();
+    assert_eq!(finish["finished"]["done"], json!({}));
+    assert!(finish["finished"].get("other").is_none());
+    let additions = events.iter().map(|event| to_json(event).unwrap()).find(|event|
+        event.pointer("/clientActions/actions/0/addMessagesToTask").is_some()).unwrap();
+    let shell = &additions["clientActions"]["actions"][0]["addMessagesToTask"]["messages"][1]["toolCall"]["runShellCommand"];
+    assert_eq!(shell["command"], "Get-Location");
+    assert_eq!(shell["isRisky"], true);
+}
