+use std::sync::OnceLock;
+use super::llms::{LLMInfo, LLMProvider, LLMUsageMetadata};
+
+pub(crate) fn enabled() -> bool { cfg!(all(feature = "openvts", not(target_family = "wasm"))) }
+
+pub(crate) fn model_info() -> Option<&'static LLMInfo> {
+    if !enabled() { return None; }
+    static MODEL: OnceLock<LLMInfo> = OnceLock::new();
+    Some(MODEL.get_or_init(|| LLMInfo {
+        display_name: "Open VTS · Qwen3.6-35B-A3B-GPTQ-Int4".into(),
+        base_model_name: "Qwen3.6-35B-A3B-GPTQ-Int4".into(),
+        id: "openvts:local".into(),
+        reasoning_level: None,
+        usage_metadata: LLMUsageMetadata { request_multiplier: 0, credit_multiplier: None },
+        description: Some("Direct requests to your own LLM API".into()),
+        disable_reason: None,
+        vision_supported: false,
+        spec: None,
+        provider: LLMProvider::Unknown,
+        host_configs: Default::default(),
+        discount_percentage: None,
+        context_window: Default::default(),
+    }))
+}
