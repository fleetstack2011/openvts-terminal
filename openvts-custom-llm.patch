+param([switch]$Installer)
+$ErrorActionPreference = 'Stop'
+Set-Location (Split-Path $PSScriptRoot -Parent)
+$iscc = $null
+if ($Installer) {
+    $command = Get-Command 'ISCC.exe' -ErrorAction SilentlyContinue
+    if ($command) { $iscc = $command.Source }
+    elseif (Test-Path "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe") { $iscc = "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe" }
+    else { throw 'Inno Setup 6 is required for -Installer.' }
+}
+function Run([string]$Program, [string[]]$Arguments) {
+    & $Program @Arguments
+    if ($LASTEXITCODE -ne 0) { throw "$Program failed with exit code $LASTEXITCODE" }
+}
+foreach ($name in @('cargo', 'rustup', 'git', 'cmake', 'protoc')) {
+    if (-not (Get-Command $name -ErrorAction SilentlyContinue)) { throw "Missing dependency: $name. See OPENVTS-README.md." }
+}
