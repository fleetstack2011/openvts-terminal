+#![cfg_attr(feature = "release_bundle", windows_subsystem = "windows")]
+use anyhow::Result;
+use warp_core::AppId;
+use warp_core::channel::{Channel, ChannelConfig, ChannelState, OzConfig, WarpServerConfig};
+
+fn main() -> Result<()> {
+    ChannelState::set(ChannelState::new(Channel::Oss, ChannelConfig {
+        app_id: AppId::new("io", "openvts", "OpenVTSTerminal"),
+        logfile_name: "openvts-terminal.log".into(),
+        server_config: WarpServerConfig {
+            server_root_url: "http://127.0.0.1:9".into(),
+            rtc_server_url: "ws://127.0.0.1:9".into(),
+            session_sharing_server_url: None,
+            firebase_auth_api_key: "".into(),
+            iap_config: None,
+        },
+        oz_config: OzConfig { oz_root_url: "http://127.0.0.1:9".into(), workload_audience_url: None },
+        telemetry_config: None,
+        crash_reporting_config: None,
+        autoupdate_config: None,
+        mcp_static_config: None,
+    }));
+    warp::run()
+}
