--- /dev/null
+++ b/openvts/Start-OpenVTS.ps1
@@ -0,0 +1,16 @@
+$ErrorActionPreference = 'Stop'
+$exe = Join-Path $PSScriptRoot 'OpenVTSTerminal.exe'
+if (-not (Test-Path $exe)) { throw 'Build the Windows distribution first. This launcher belongs next to OpenVTSTerminal.exe.' }
+$secure = Read-Host 'Your LLM API token (without Bearer)' -AsSecureString
+$ptr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure)
+try {
+    $token = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)
+    if ([string]::IsNullOrWhiteSpace($token) -or $token -eq 'bearer_token_place_here' -or $token.StartsWith('Bearer ') -or $token -match '[\r\n]') { throw 'Enter your actual token without the Bearer prefix.' }
+    $env:OPENVTS_LLM_API_KEY = $token
+    Start-Process -FilePath $exe -WorkingDirectory $PSScriptRoot | Out-Null
+} finally {
+    Remove-Item Env:OPENVTS_LLM_API_KEY -ErrorAction SilentlyContinue
+    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr)
+    $token = $null
+    $secure.Dispose()
+}
